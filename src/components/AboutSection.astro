---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';
import {
  ROCIS_SCHEDULE_REPO,
  ROCIS_SCHEDULE_REPO_URL,
  ROCIS_TASKS_REPO,
  ROCIS_TASKS_PLAY_URL
} from '../data/projects';
import SectionHeader from './SectionHeader.astro';
import GithubStatus from './GithubStatus.astro';
import { BorderBeam } from './lightswind/border-beam';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang].about;

const metrics = [
  { value: '30+', label: t.metrics.services },
  { value: '4+', label: t.metrics.apps },
  { value: '99.9%', label: t.metrics.availability },
  { value: 'B.Sc.', label: t.metrics.degree }
];

const services = [
  { icon: 'fa-solid fa-mobile-screen-button', title: t.svc_mobile_title, desc: t.svc_mobile_desc },
  { icon: 'fa-solid fa-bolt', title: t.svc_ee_title, desc: t.svc_ee_desc },
  { icon: 'fa-solid fa-server', title: t.svc_sys_title, desc: t.svc_sys_desc, link: { href: '#homelab', label: t.svc_sys_btn } },
  { icon: 'fa-solid fa-robot', title: t.svc_ai_title, desc: t.svc_ai_desc }
];
---

<section id="about" class="section section--hero" aria-labelledby="about-title">
  <SectionHeader id="about-title" eyebrow={t.eyebrow} title={t.title} lede={t.lede} large lang={lang} />

  <div class="hero-actions">
    <a href="#projects" class="btn btn--primary">
      {t.cta_projects}
      <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
    </a>
    <a href="#contact" class="btn btn--ghost">{t.cta_contact}</a>
    <a href="https://github.com/RoeeIlouz" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
      <i class="fa-brands fa-github" aria-hidden="true"></i> GitHub
    </a>
  </div>

  <dl class="stats">
    {metrics.map((m) => (
      <div class="stat">
        <dt class="stat-label">{m.label}</dt>
        <dd class="stat-value">{m.value}</dd>
      </div>
    ))}
  </dl>

  <h3 class="sub-heading">{t.featured_heading}</h3>
  <div class="featured-grid">
    <article class="feature-card feature-card--tasks">
      <BorderBeam client:only="react" size={120} duration={7} colorFrom="#ef4444" colorTo="#f87171" glowIntensity={0.6} />
      <div class="feature-top">
        <span class="badge badge--live">{t.tasks.status}</span>
        <span class="feature-kind">{t.tasks.sub}</span>
      </div>
      <div class="feature-head">
        <img src="/images/rocis-tasks-icon.png" alt="" width="52" height="52" class="app-icon" loading="lazy" decoding="async" />
        <div class="feature-heading">
          <h4 class="feature-title">ROCIs Tasks</h4>
        </div>
      </div>
      <p class="feature-desc">{t.tasks.desc}</p>
      <ul class="check-list">
        {t.tasks.points.map((p) => <li>{p}</li>)}
      </ul>
      <GithubStatus repo={ROCIS_TASKS_REPO} lang={lang} defaultStars={1} defaultLanguage="Dart" />
      <div class="feature-actions">
        <a href={ROCIS_TASKS_PLAY_URL} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm">
          <i class="fa-brands fa-google-play" aria-hidden="true"></i> Google Play
        </a>
        <a href="https://tasks.rocisapps.com" target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--sm">
          <i class="fa-solid fa-globe" aria-hidden="true"></i> {t.tasks.btn_web}
        </a>
        <a href={`https://github.com/${ROCIS_TASKS_REPO}`} target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--sm">
          <i class="fa-brands fa-github" aria-hidden="true"></i> {t.btn_source}
        </a>
      </div>
    </article>

    <article class="feature-card feature-card--schedule">
      <BorderBeam client:only="react" size={120} duration={7} colorFrom="#0ea5e9" colorTo="#34d399" glowIntensity={0.6} />
      <div class="feature-top">
        <span class="badge badge--wip">{t.schedule.status}</span>
        <span class="feature-kind">{t.schedule.sub}</span>
      </div>
      <div class="feature-head">
        <img src="/images/rocis-schedule-icon.png" alt="" width="52" height="52" class="app-icon app-icon--round" loading="lazy" decoding="async" />
        <div class="feature-heading">
          <h4 class="feature-title">ROCIs Schedule</h4>
        </div>
      </div>
      <p class="feature-desc">{t.schedule.desc}</p>
      <ul class="check-list">
        {t.schedule.points.map((p) => <li>{p}</li>)}
      </ul>
      <GithubStatus repo={ROCIS_SCHEDULE_REPO} lang={lang} defaultStars={1} defaultLanguage="Dart" />
      <div class="feature-actions">
        <a href="https://rocisapps.com/#schedule" target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm">
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> {t.schedule.btn_page}
        </a>
        <a href={ROCIS_SCHEDULE_REPO_URL} target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--sm">
          <i class="fa-brands fa-github" aria-hidden="true"></i> {t.btn_source}
        </a>
      </div>
    </article>
  </div>

  <h3 class="sub-heading">{t.doing_heading}</h3>
  <div class="card-grid card-grid--2">
    {services.map((s) => (
      <div class="card">
        <span class="icon-tile" aria-hidden="true"><i class={s.icon}></i></span>
        <h4 class="card-title">{s.title}</h4>
        <p class="card-text">{s.desc}</p>
        {s.link && (
          <a href={s.link.href} class="text-link">
            {s.link.label} <i class="fa-solid fa-arrow-right flip-rtl" aria-hidden="true"></i>
          </a>
        )}
      </div>
    ))}
  </div>
</section>
