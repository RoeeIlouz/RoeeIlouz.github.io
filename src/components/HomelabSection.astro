---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';
import { homelabSpecs, zeroTrustServices, modularStacks, maintenanceScripts } from '../data/homelab';
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang].homelab;
---

<section id="homelab" class="section" aria-labelledby="homelab-title">
  <SectionHeader id="homelab-title" eyebrow={t.eyebrow} title={t.title} lede={t.lede} />

  <div class="banner">
    <span class="banner-icon" aria-hidden="true">
      <img src="/images/raspberry-pi-icon.png" alt="" width="26" height="32" loading="lazy" decoding="async" />
    </span>
    <div class="banner-body">
      <h3 class="banner-title">{t.banner_title}</h3>
      <p class="banner-text"><Fragment set:html={t.banner_desc} /></p>
      <ul class="chips">
        {t.banner_chips.map((c) => <li class="chip chip--accent">{c}</li>)}
      </ul>
    </div>
    <a href="https://github.com/RoeeIlouz/Homelab" target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm banner-cta">
      <i class="fa-brands fa-github" aria-hidden="true"></i> {t.banner_btn}
    </a>
  </div>

  <div class="block">
    <h3 class="sub-heading"><i class="fa-solid fa-microchip" aria-hidden="true"></i>{t.hw_heading}</h3>
    <dl class="card-grid card-grid--4">
      {homelabSpecs.map((spec) => (
        <div class="card card--compact">
          <span class="icon-tile icon-tile--sm" aria-hidden="true"><i class={spec.icon}></i></span>
          <dt class="card-kicker">{spec.title[lang]}</dt>
          <dd class="card-title card-title--sm">{spec.value[lang]}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="block">
    <h3 class="sub-heading"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>{t.sec_heading}</h3>
    <div class="card-grid card-grid--2">
      {zeroTrustServices.map((svc) => (
        <div class="card">
          <span class="icon-tile" aria-hidden="true"><i class={svc.icon}></i></span>
          <h4 class="card-title">{svc.title[lang]}</h4>
          <p class="card-text">{svc.description[lang]}</p>
          <ul class="chips">{svc.badges.map((b) => <li class="chip">{b}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>

  <div class="block">
    <h3 class="sub-heading"><i class="fa-solid fa-layer-group" aria-hidden="true"></i>{t.stacks_heading}</h3>
    <div class="card-grid card-grid--2">
      {modularStacks.map((stack) => (
        <div class="card">
          <span class="icon-tile" aria-hidden="true"><i class={stack.icon}></i></span>
          <h4 class="card-title">{stack.title[lang]}</h4>
          <p class="card-text">{stack.description[lang]}</p>
          <ul class="chips">{stack.badges.map((b) => <li class="chip">{b}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>

  <div class="block">
    <h3 class="sub-heading"><i class="fa-solid fa-gears" aria-hidden="true"></i>{t.ops_heading}</h3>
    <div class="terminal" dir="ltr">
      <div class="terminal-bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <p class="terminal-title">pi@homelab: ~/scripts</p>
      </div>
      <ul class="terminal-body">
        {maintenanceScripts.map((script) => (
          <li>
            <span class="terminal-prompt" aria-hidden="true">$</span>
            <code class="terminal-cmd">./{script.name}</code>
            <span class="terminal-comment" dir="auto"># {script.description[lang]}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
