---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';
import { leadershipExperience, educationList, certificationsList, skillCategories } from '../data/experience';
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang].experience;

const timelines = [
  { icon: 'fa-solid fa-briefcase', heading: t.heading_exp, items: leadershipExperience },
  { icon: 'fa-solid fa-graduation-cap', heading: t.heading_edu, items: educationList }
];
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <SectionHeader id="experience-title" eyebrow={t.eyebrow} title={t.title} lang={lang} />

  {timelines.map((group) => (
    <div class="block">
      <h3 class="sub-heading">
        <i class={group.icon} aria-hidden="true"></i>
        {group.heading}
      </h3>
      <ol class="timeline">
        {group.items.map((item) => (
          <li class="timeline-item">
            <h4 class="timeline-title">{item.title[lang]}</h4>
            <p class="timeline-meta">{item.meta[lang]}</p>
            <p class="timeline-text">{item.description[lang]}</p>
          </li>
        ))}
      </ol>
    </div>
  ))}

  <div class="block">
    <h3 class="sub-heading">
      <i class="fa-solid fa-certificate" aria-hidden="true"></i>
      {t.heading_certs}
    </h3>
    <ul class="card-grid card-grid--4">
      {certificationsList.map((cert) => (
        <li class="card card--compact">
          <span class="icon-tile icon-tile--sm" aria-hidden="true"><i class={cert.icon}></i></span>
          <p class="card-kicker">{cert.provider}</p>
          <p class="card-title card-title--sm">{cert.title[lang]}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="block">
    <h3 class="sub-heading">
      <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i>
      {t.heading_skills}
    </h3>
    <div class="card-grid card-grid--2">
      {skillCategories.map((cat) => (
        <div class="card">
          <h4 class="card-title card-title--row">
            <i class={cat.icon} aria-hidden="true"></i>
            {cat.title[lang]}
          </h4>
          <ul class="chips">
            {cat.skills.map((s) => (
              <li class:list={['chip', 'chip--lg', { 'chip--learning': s.learning }]}>
                {s.icon && <i class={s.icon} aria-hidden="true"></i>}
                {typeof s.label === 'string' ? s.label : s.label[lang]}
                {s.learning && <span class="chip-note">{t.learning}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
