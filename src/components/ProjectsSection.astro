---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';
import { projectsData } from '../data/projects';
import SectionHeader from './SectionHeader.astro';
import GithubStatus from './GithubStatus.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang].projects;

const filters = [
  { id: 'all', label: t.filter_all },
  { id: 'mobile', label: t.filter_mobile },
  { id: 'web', label: t.filter_web },
  { id: 'systems', label: t.filter_systems }
];

const statusLabel = { live: t.status_live, wip: t.status_wip, active: t.status_active };
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="section-head-row">
    <SectionHeader id="projects-title" eyebrow={t.eyebrow} title={t.title} lede={t.lede} />
    <a href="https://github.com/RoeeIlouz?tab=repositories" target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--sm">
      <i class="fa-brands fa-github" aria-hidden="true"></i> {t.view_all_github}
    </a>
  </div>

  <div class="toolbar">
    <div class="search">
      <i class="fa-solid fa-magnifying-glass search-icon" aria-hidden="true"></i>
      <input
        type="search"
        id="project-search"
        class="search-input"
        placeholder={t.search_placeholder}
        aria-label={t.search_label}
        autocomplete="off"
        spellcheck="false"
        maxlength="80"
      />
    </div>
    <div class="segmented" role="group" aria-label={t.filter_label}>
      {filters.map((f, i) => (
        <button type="button" class="segmented-btn" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}
        </button>
      ))}
    </div>
  </div>

  <p id="no-projects" class="empty-state" hidden>
    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    {t.no_results}
  </p>

  <div class="project-grid" id="project-grid">
    {projectsData.map((proj) => (
      <article
        class="project-card"
        data-category={proj.category}
        data-search={[proj.title[lang], proj.description[lang], proj.tag[lang], ...proj.tech].join(' ').toLowerCase()}
      >
        <div class="project-head">
          <span class:list={['project-icon', { 'project-icon--contain': proj.imageFit === 'contain' }]}>
            {proj.image
              ? <img src={proj.image} alt="" width="40" height="40" loading="lazy" decoding="async" />
              : <i class={proj.icon} aria-hidden="true"></i>}
          </span>
          <span class={`badge badge--${proj.status}`}>{proj.status === 'wip' ? statusLabel.wip : proj.tag[lang]}</span>
        </div>

        <h3 class="project-title">{proj.title[lang]}</h3>
        <p class="project-desc">{proj.description[lang]}</p>

        <ul class="chips">
          {proj.tech.map((tech) => <li class="chip">{tech}</li>)}
        </ul>

        <div class="project-foot">
          {proj.githubRepo && (
            <GithubStatus
              repo={proj.githubRepo}
              lang={lang}
              defaultStars={proj.defaultStars}
              defaultForks={proj.defaultForks}
              defaultLanguage={proj.defaultLanguage}
            />
          )}
          <div class="project-links">
            {proj.links.map((link) => {
              const label = link.label ?? (link.labelKey ? t[link.labelKey] : '');
              return (
                <a
                  href={link.url}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class:list={['btn', 'btn--sm', link.primary ? 'btn--primary' : 'btn--ghost']}
                >
                  <i class={link.icon} aria-hidden="true"></i>
                  {label}
                </a>
              );
            })}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
