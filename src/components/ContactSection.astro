---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang].contact;
const email = 'roee.ilouz@gmail.com';
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <SectionHeader id="contact-title" eyebrow={t.eyebrow} title={t.title} lede={t.lede} lang={lang} />

  <div class="contact-grid">
    <ul class="contact-methods">
      <li class="contact-method">
        <span class="icon-tile icon-tile--sm" aria-hidden="true"><i class="fa-solid fa-envelope"></i></span>
        <div class="contact-method-body">
          <p class="card-kicker">{t.email_label}</p>
          <a href={`mailto:${email}`} dir="ltr">{email}</a>
        </div>
        <button
          type="button"
          class="icon-btn"
          data-copy-email={email}
          data-toast={t.toast_copied}
          aria-label={t.copy_aria}
          title={t.btn_copy_email}
        >
          <i class="fa-solid fa-copy" aria-hidden="true"></i>
        </button>
      </li>
      <li class="contact-method">
        <span class="icon-tile icon-tile--sm" aria-hidden="true"><i class="fa-brands fa-github"></i></span>
        <div class="contact-method-body">
          <p class="card-kicker">{t.github_label}</p>
          <a href="https://github.com/RoeeIlouz" target="_blank" rel="noopener noreferrer me" dir="ltr">github.com/RoeeIlouz</a>
        </div>
      </li>
      <li class="contact-method">
        <span class="icon-tile icon-tile--sm" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></span>
        <div class="contact-method-body">
          <p class="card-kicker">{t.location_label}</p>
          <p>{translations[lang].sidebar.val_location}</p>
        </div>
      </li>
    </ul>

    <form id="contact-form" class="contact-form card" data-email={email} data-toast={t.toast_email} novalidate>
      <div class="form-row">
        <div class="field">
          <label for="cf-name">{t.label_name}</label>
          <input type="text" id="cf-name" name="name" placeholder={t.placeholder_name} required maxlength="100" autocomplete="name" />
        </div>
        <div class="field">
          <label for="cf-email">{t.label_email}</label>
          <input type="email" id="cf-email" name="email" placeholder={t.placeholder_email} required maxlength="200" autocomplete="email" dir="ltr" />
        </div>
      </div>
      <div class="field">
        <label for="cf-message">{t.label_message}</label>
        <textarea id="cf-message" name="message" placeholder={t.placeholder_message} required maxlength="2000" rows="5"></textarea>
      </div>
      <div class="form-foot">
        <p class="form-note">
          <i class="fa-solid fa-lock" aria-hidden="true"></i>
          {t.form_note}
        </p>
        <button type="submit" class="btn btn--primary">
          <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> {t.btn_submit}
        </button>
      </div>
    </form>
  </div>
</section>
