---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';
import { ROCIS_SCHEDULE_REPO_URL, ROCIS_TASKS_PLAY_URL } from '../data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang].sidebar;

const facts = [
  { icon: 'fa-solid fa-graduation-cap', label: t.label_education, value: t.val_education },
  { icon: 'fa-solid fa-location-dot', label: t.label_location, value: t.val_location },
  { icon: 'fa-solid fa-language', label: t.label_languages, value: t.val_languages }
];

const apps = [
  {
    name: 'ROCIs Tasks',
    icon: '/images/rocis-tasks-icon.png',
    href: ROCIS_TASKS_PLAY_URL,
    status: t.status_live,
    variant: 'live'
  },
  {
    name: 'ROCIs Schedule',
    icon: '/images/rocis-schedule-icon.png',
    href: ROCIS_SCHEDULE_REPO_URL,
    status: t.status_wip,
    variant: 'wip',
    round: true
  }
];
---

<aside class="sidebar">
  <div class="profile">
    <div class="avatar">
      <img src="/images/avatar.jpg" alt="" width="96" height="96" loading="eager" decoding="async" />
      <span class="avatar-status" aria-hidden="true"></span>
    </div>
    <h1 class="profile-name">{t.name}</h1>
    <p class="profile-role">{t.role}</p>
    <p class="availability">
      <span class="pulse" aria-hidden="true"></span>
      {t.available}
    </p>
  </div>

  <dl class="facts">
    {facts.map((f) => (
      <div class="fact">
        <dt><i class={f.icon} aria-hidden="true"></i>{f.label}</dt>
        <dd>{f.value}</dd>
      </div>
    ))}
  </dl>

  <div class="ecosystem">
    <p class="ecosystem-title">
      <span>{t.ecosystem}</span>
      <a href="https://rocisapps.com" target="_blank" rel="noopener noreferrer">rocisapps.com</a>
    </p>
    <ul class="ecosystem-list">
      {apps.map((app) => (
        <li>
          <a href={app.href} target="_blank" rel="noopener noreferrer" class="ecosystem-app">
            <img src={app.icon} alt="" width="28" height="28" class:list={[{ round: app.round }]} loading="lazy" decoding="async" />
            <span class="ecosystem-name">{app.name}</span>
            <span class={`badge badge--${app.variant}`}>{app.status}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="sidebar-actions">
    <a href="#contact" class="btn btn--primary btn--block">
      <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
      {t.cta}
    </a>
    <div class="socials">
      <a href="https://github.com/RoeeIlouz" target="_blank" rel="noopener noreferrer me" class="icon-btn" aria-label="GitHub">
        <i class="fa-brands fa-github" aria-hidden="true"></i>
      </a>
      <a href="mailto:roee.ilouz@gmail.com" class="icon-btn" aria-label="Email">
        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</aside>
