---
import { ShinyText } from './lightswind/shiny-text';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  large?: boolean;
  lang?: 'en' | 'he';
}

const { id, eyebrow, title, lede, large = false, lang = 'en' } = Astro.props;
---

<header class="section-head">
  <p class="eyebrow">
    <ShinyText client:visible direction={lang === 'he' ? 'right-to-left' : 'left-to-right'} speed={3.5} className="font-mono text-xs uppercase tracking-widest text-inherit">
      {eyebrow}
    </ShinyText>
  </p>
  <h2 id={id} class:list={['section-title', { 'section-title--hero': large }]}>{title}</h2>
  {lede && <p class="section-lede"><Fragment set:html={lede} /></p>}
</header>
