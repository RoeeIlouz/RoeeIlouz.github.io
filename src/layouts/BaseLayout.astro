---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/heebo';
import '@fortawesome/fontawesome-free/css/fontawesome.min.css';
import '@fortawesome/fontawesome-free/css/solid.min.css';
import '@fortawesome/fontawesome-free/css/brands.min.css';
import '../styles/global.css';
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  lang: Lang;
  /** Set on sub-pages (e.g. notes); home pages use the translated meta. */
  title?: string;
  description?: string;
}

const { lang, title: pageTitle, description: pageDescription } = Astro.props;
const t = translations[lang];
const isRtl = lang === 'he';
const siteUrl = 'https://roee.ilouz.xyz';
const isHome = pageTitle === undefined;
const canonical = `${siteUrl}${Astro.url.pathname}`;
const title = pageTitle ?? t.meta.title;
const description = pageDescription ?? t.meta.description;
const ogImage = `${siteUrl}/images/avatar.jpg`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Roee Ilouz',
  alternateName: ['ROCI', 'רועי אילוז'],
  url: siteUrl,
  image: ogImage,
  jobTitle: 'Electrical Engineering Student & Mobile Developer',
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Afeka College of Engineering'
  },
  knowsAbout: [
    'Electrical Engineering',
    'Flutter',
    'Dart',
    'Mobile Application Development',
    'Linux',
    'Docker',
    'Zero Trust Networking'
  ],
  sameAs: [
    'https://github.com/RoeeIlouz',
    'https://rocisapps.com'
  ]
};
---

<!DOCTYPE html>
<html lang={lang} dir={isRtl ? 'rtl' : 'ltr'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#09090b" />
  <meta name="google-site-verification" content="UA_6j9NEGu3aBu7P_cL6vkusxH26-WcNpCITqrg-dBE" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Roee Ilouz" />

  <link rel="canonical" href={canonical} />
  {isHome && <link rel="alternate" hreflang="en" href={`${siteUrl}/`} />}
  {isHome && <link rel="alternate" hreflang="he" href={`${siteUrl}/he/`} />}
  {isHome && <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />}

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={isHome ? 'profile' : 'article'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={isRtl ? 'he_IL' : 'en_US'} />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/jpeg" href="/images/avatar.jpg" />
  <link rel="apple-touch-icon" href="/images/avatar.jpg" />
  <link rel="sitemap" href="/sitemap.xml" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip-link" href="#main">{t.skip}</a>
  <SiteHeader lang={lang} />
  <div class="container page">
    <Sidebar lang={lang} />
    <main id="main" class="content" tabindex="-1">
      <slot />
    </main>
  </div>
  <SiteFooter lang={lang} />
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    import '../scripts/main.ts';
  </script>
</body>
</html>
